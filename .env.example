# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).

# --- Telegram (required to run the bot) ---
TELEGRAM_TOKEN=123456:ABC-your-bot-token-from-BotFather
GATEKEEPER_GROUP_ID=-1001234567890
MASTER_PASSWORD=change-me

# --- Storage ---
# Leave the two UPSTASH vars unset to use a local JSON file (fine on a VM).
# Set both to store all state in Upstash Redis (needed on serverless hosts).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Path for the local JSON store (only used when Upstash is not configured).
# RADAR_STATE_FILE=radar_state.json

# --- Optional: /ask natural-language assistant (free LLM) ---
# Set ONE of these to enable /ask. Gemini takes precedence if both are set.
# GEMINI_API_KEY=...   # https://aistudio.google.com/apikey  (free)
# GROQ_API_KEY=...     # https://console.groq.com/keys       (free)
